{
  "name": "sl-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "blocksTemplate": "react",
  "blocksTemplateDescription": "Vite + React 19 frontend with Cognito authentication",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch aws-blocks/scripts/server.ts",
    "dev": "tsx watch aws-blocks/scripts/server.ts",
    "seed-admin": "tsx aws-blocks/scripts/seed-admin.ts",
    "migrate-folders": "tsx aws-blocks/scripts/migrate-folders.ts",
    "reindex": "tsx aws-blocks/scripts/reindex.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "test:unit": "tsx --test \"test/unit/*.test.ts\"",
    "test:e2e": "tsx -C browser test/e2e.test.ts",
    "vendorize": "blocks-vendorize"
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "@aws-sdk/client-bedrock-agent": "^3.1105.0",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@cloudscape-design/components": "^3.0.1342",
    "@cloudscape-design/design-tokens": "^3.0.105",
    "@cloudscape-design/global-styles": "^1.0.65",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "aws-blocks": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "idb-keyval": "^6.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1105.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "blocksTemplateVersion": "0.1.0"
}